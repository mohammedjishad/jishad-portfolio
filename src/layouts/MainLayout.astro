---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mohammed Jishad | Python & Odoo Developer | ERP Implementation",
  description = "Portfolio of Mohammed Jishad, a Python & Odoo Developer specializing in custom Odoo 17 & 18 module development, business automation, OWL 2, and PostgreSQL.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://mohammedjishad.github.io");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Mohammed Jishad" />
    <meta name="keywords" content="Mohammed Jishad, Odoo Developer, Python Developer, ERP Implementation, Odoo 18, Odoo 17, OWL 2, PostgreSQL, Textile ERP, Kerala, India" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / LinkedIn / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${base}/images/textile-erp/dashboard.png`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${base}/images/textile-erp/dashboard.png`} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Theme Initialization Script (Avoids theme flashing) -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme) {
          document.documentElement.setAttribute('data-theme', storedTheme);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <!-- Top Scroll Progress Bar -->
    <div id="scroll-progress" class="scroll-progress-bar" aria-hidden="true"></div>

    <slot />

    <!-- Smooth Scroll Reveal, Progress Bar & Hexafolio Card Spotlight -->
    <script>
      // 1. Reading Progress Bar
      const progressBar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        if (progressBar) {
          progressBar.style.width = `${progress}%`;
        }
      }, { passive: true });

      // 2. Smooth Intersection Observer for Scroll Reveals
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, {
        root: null,
        rootMargin: '0px 0px -40px 0px',
        threshold: 0.08
      });

      document.querySelectorAll('.reveal, .reveal-stagger').forEach(el => {
        revealObserver.observe(el);
      });

      // 3. Interactive Card Spotlight Tracking (Hexafolio / modern award-winning aesthetic)
      const spotlightSelector = '.card, .pillar-card, .client-project-card, .flagship-card, .timeline-content, .edu-card, .cert-card, .contact-item-box';
      const spotlightCards = document.querySelectorAll<HTMLElement>(spotlightSelector);

      spotlightCards.forEach(card => {
        card.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });

        card.addEventListener('mouseleave', () => {
          card.style.setProperty('--mouse-x', '-999px');
          card.style.setProperty('--mouse-y', '-999px');
        });
      });

      // 4. Smooth Anchor Link Navigation
      document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
          const href = this.getAttribute('href');
          if (!href) return;
          const hashIndex = href.indexOf('#');
          if (hashIndex === -1) return;
          const targetId = href.substring(hashIndex + 1);
          const targetElement = document.getElementById(targetId);

          if (targetElement) {
            e.preventDefault();
            const headerOffset = 80;
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });

            // Update URL hash smoothly without jump
            history.pushState(null, '', `#${targetId}`);
          }
        });
      });
    </script>
  </body>
</html>
