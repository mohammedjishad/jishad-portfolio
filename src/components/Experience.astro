---
const experiences = [
  {
    role: "Python & Odoo Developer (Trainee)",
    company: "Prosevo Technologies",
    location: "Malappuram, Kerala, India",
    period: "Feb 2026 – Present",
    current: true,
    description: "Developing custom Odoo 18 modules for live, multi-branch enterprise client implementations, translating functional business requirements into production-ready software.",
    points: [
      "Built backend business logic using Python & Odoo ORM: custom models, model inheritance (_inherit), computed/related fields, SQL constraints, and TransientModel wizards.",
      "Designed and extended XML views (form, tree, kanban, search, pivot) using XPath inheritance, and built QWeb templates for PDF, A4, and 80mm thermal POS receipts.",
      "Customised the Odoo frontend using OWL 2 components, JavaScript patches, and SCSS overrides for POS and backend web-client interfaces.",
      "Engineered Odoo HTTP controllers (@http.route) for customer-portal access and API-style JSON/JSON-RPC endpoints.",
      "Implemented multi-company and multi-branch architectures with ir.rule record-rule security and branch-scoped visibility.",
      "Configured end-to-end Sales, Purchase, Inventory, Manufacturing, and Accounting workflows, including Indian GST tax reporting (GSTR-1, GSTR-3B).",
      "Wrote and optimized PostgreSQL queries for reporting wizards, financial reconciliation logic, and automated ir.cron scheduled actions.",
      "Managed development through Git branching workflows (feature branches, code review, promotion across Dev, Quality, and UAT) on containerized Docker Compose stacks.",
      "Future-Proof Architecture & Research: Actively tracking Odoo master branch and upcoming release roadmaps (Odoo 19 & 20) to ensure new custom modules adhere to upcoming OWL and ORM architectural standards."
    ],
    tags: ["Odoo 18 & 17", "Python 3.12", "OWL 2", "PostgreSQL", "ir.rule", "ir.cron", "Docker Compose", "Git", "Indian GST", "Roadmap (19/20)"]
  },
  {
    role: "Process Executive",
    company: "Infolks",
    location: "Palakkad, Kerala, India",
    period: "Mar 2025 – Sep 2025",
    current: false,
    description: "Ensured high-fidelity data pipelines for computer vision and machine learning models with automated validation.",
    points: [
      "Performed data labeling and rigorous QA validation for computer vision datasets.",
      "Engineered Python-based validation scripts for dataset filtering, schema consistency checks, and outlier detection.",
      "Collaborated with data engineering leads to maintain strict precision benchmarks across model training pipelines."
    ],
    tags: ["Python", "Data Quality Assurance", "Validation Scripts", "Computer Vision Datasets"]
  },
  {
    role: "Data Science & Analytics Intern",
    company: "iDatalytics",
    location: "Kochi, Kerala, India",
    period: "Aug 2024 – Nov 2024",
    current: false,
    description: "Conducted exploratory data analysis, business intelligence modeling, and interactive KPI dashboard engineering—building the analytical rigor that directly powers my Odoo ERP database optimization, custom reporting wizards, and production costing logic.",
    points: [
      "Exploratory Data Analysis (EDA) & Data Cleansing: Leveraged Python (Pandas, NumPy) and SQL to extract, clean, and analyze enterprise transactional datasets, identifying operational patterns and anomaly distributions.",
      "Interactive BI Dashboard Engineering: Designed and deployed executive Power BI dashboards featuring real-time KPI metrics, revenue trends, and performance tracking for multi-tier stakeholder decision-making.",
      "SQL Database Query Optimization: Formulated complex SQL queries (multi-table JOINs, aggregations, window functions, and indexing strategies) that accelerated recurring financial and operational reporting cycles.",
      "The Odoo + Data Analytics Advantage: Combined statistical data analytics with Odoo ERP development to bridge transactional PostgreSQL databases with high-level business intelligence—directly informing custom Odoo management dashboards, margin analyses, and reporting wizards."
    ],
    tags: ["Data Analytics", "Power BI", "SQL Analytics", "Python EDA (Pandas / NumPy)", "Business Intelligence", "Database Optimization", "KPI Dashboards", "Data Modeling"]
  }
];
---

<section class="section experience-section" id="experience">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">03 // Professional Experience</span>
      <h2 class="section-title">Career Milestones & Engineering Impact</h2>
      <p class="section-subtitle">
        Hands-on experience delivering live ERP customizations, automated workflows, and data-driven solutions.
      </p>
    </div>

    <div class="timeline">
      {experiences.map(exp => (
        <div class="timeline-item reveal">
          <!-- Timeline Marker -->
          <div class="timeline-marker">
            <div class={`marker-dot ${exp.current ? 'current' : ''}`}></div>
            <div class="timeline-line"></div>
          </div>

          <!-- Timeline Content -->
          <div class="timeline-content card">
            <div class="timeline-header">
              <div class="timeline-title-wrap">
                <div class="role-title-row">
                  <h3 class="exp-role">{exp.role}</h3>
                  {exp.current && (
                    <span class="badge badge-active">Current Role</span>
                  )}
                </div>
                <div class="exp-company-row">
                  <span class="exp-company">{exp.company}</span>
                  <span class="bullet-sep">•</span>
                  <span class="exp-location">{exp.location}</span>
                </div>
              </div>

              <div class="exp-period-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                  <line x1="16" x2="16" y1="2" y2="6"/>
                  <line x1="8" x2="8" y1="2" y2="6"/>
                  <line x1="3" x2="21" y1="10" y2="10"/>
                </svg>
                <span>{exp.period}</span>
              </div>
            </div>

            <p class="exp-summary">{exp.description}</p>

            <ul class="exp-points">
              {exp.points.map(pt => (
                <li>
                  <span class="point-bullet">›</span>
                  <span class="point-text">{pt}</span>
                </li>
              ))}
            </ul>

            <div class="exp-tags">
              {exp.tags.map(t => (
                <span class="badge">{t}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1.5rem;
    position: relative;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--border-strong);
    border: 3px solid var(--bg-primary);
    z-index: 2;
    transition: all var(--transition-fast);
  }

  .marker-dot.current {
    background-color: var(--accent-primary);
    box-shadow: 0 0 0 4px var(--accent-glow);
  }

  .timeline-line {
    position: absolute;
    top: 14px;
    bottom: -2rem;
    width: 2px;
    background-color: var(--border-subtle);
  }

  .timeline-item:last-child .timeline-line {
    display: none;
  }

  .timeline-content {
    padding: 2rem;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .role-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.35rem;
  }

  .exp-role {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .exp-company-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .exp-company {
    font-weight: 600;
    color: var(--accent-primary);
  }

  .bullet-sep {
    color: var(--text-muted);
  }

  .exp-location {
    color: var(--text-muted);
  }

  .exp-period-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    background-color: var(--bg-tertiary);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .exp-summary {
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    line-height: 1.6;
    font-weight: 500;
  }

  .exp-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .exp-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .point-bullet {
    color: var(--accent-primary);
    font-size: 1.2rem;
    line-height: 1.2;
    font-weight: 800;
  }

  .point-text {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .timeline-item {
      grid-template-columns: 1fr;
    }

    .timeline-marker {
      display: none;
    }

    .timeline-content {
      padding: 1.5rem;
    }

    .timeline-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
