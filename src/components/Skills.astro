---
const skillCategories = [
  {
    title: "Odoo Core & Architecture",
    icon: "layers",
    skills: [
      "Odoo 18 (Community & Enterprise)",
      "Odoo 17 Community",
      "Odoo ORM (Python)",
      "Custom Module Architecture",
      "Model Inheritance (_inherit, _inherits)",
      "TransientModel Wizards",
      "Scheduled Actions (ir.cron)",
      "Security Groups & ir.rule",
      "Multi-Company / Multi-Branch"
    ]
  },
  {
    title: "Functional ERP Workflows",
    icon: "briefcase",
    skills: [
      "Manufacturing (MRP & BOM)",
      "Inventory & Roll Traceability",
      "Point of Sale (POS)",
      "Sales & Invoicing",
      "Purchase Management",
      "Multi-Journal Accounting",
      "Helpdesk & Service Operations",
      "HR & Attendance Workflows",
      "Executive Reporting"
    ]
  },
  {
    title: "Frontend & Web Views",
    icon: "code",
    skills: [
      "OWL 2 (Odoo Web Library)",
      "JavaScript (ES6+)",
      "XML Views (Form, Tree, Kanban, Pivot)",
      "XPath View Inheritance",
      "QWeb PDF Templates",
      "80mm Thermal Receipt Templates",
      "HTML5 & CSS3 / SCSS",
      "Responsive Web UI"
    ]
  },
  {
    title: "Backend, Database & APIs",
    icon: "database",
    skills: [
      "Python 3.12",
      "PostgreSQL (Optimization, Indexing)",
      "SQL Query Writing",
      "Odoo HTTP Controllers (@http.route)",
      "JSON-RPC Endpoints",
      "RESTful API Integration",
      "XLSX Reports (xlsxwriter)",
      "Customer Portal Controllers"
    ]
  },
  {
    title: "DevOps & Engineering Tools",
    icon: "terminal",
    skills: [
      "Docker & Docker Compose",
      "Git (Branching, Code Review)",
      "Linux Administration",
      "Multi-Environment Deployment (Dev, QA, UAT)",
      "VS Code & PyCharm",
      "Module Debugging & Testing",
      "Agile Collaboration"
    ]
  },
  {
    title: "Data Analytics & Compliance",
    icon: "pie-chart",
    skills: [
      "Indian GST (GSTR-1, GSTR-3B)",
      "Power BI Dashboards",
      "Exploratory Data Analysis (EDA)",
      "SQL Analytics",
      "Google BigQuery",
      "Dataset Validation Scripts",
      "Excel Financial Modeling"
    ]
  }
];
---

<section class="section skills-section" id="skills">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">02 // Technical Skills</span>
      <h2 class="section-title">Specialized Engineering & Functional Competencies</h2>
      <p class="section-subtitle">
        Organized by architectural domain—grounded in real-world ERP implementations, not arbitrary percentage bars.
      </p>
    </div>

    <div class="skills-grid">
      {skillCategories.map(cat => (
        <div class="card skill-card">
          <div class="skill-card-header">
            <div class="skill-icon-wrap">
              {cat.icon === 'layers' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
                  <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/>
                  <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>
                </svg>
              )}
              {cat.icon === 'briefcase' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
              )}
              {cat.icon === 'code' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6"/>
                  <polyline points="8 6 2 12 8 18"/>
                </svg>
              )}
              {cat.icon === 'database' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <ellipse cx="12" cy="5" rx="9" ry="3"/>
                  <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
                  <path d="M3 12A9 3 0 0 0 21 12"/>
                </svg>
              )}
              {cat.icon === 'terminal' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="4 17 10 11 4 5"/>
                  <line x1="12" x2="20" y1="19" y2="19"/>
                </svg>
              )}
              {cat.icon === 'pie-chart' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.21 15.89A10 10 0 1 1 8 2.83"/>
                  <path d="M22 12A10 10 0 0 0 12 2v10z"/>
                </svg>
              )}
            </div>
            <h3 class="skill-category-title">{cat.title}</h3>
          </div>

          <div class="skill-tags">
            {cat.skills.map(s => (
              <span class="skill-tag">{s}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .skill-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    height: 100%;
  }

  .skill-card-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .skill-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background-color: var(--accent-subtle);
    color: var(--accent-text);
    flex-shrink: 0;
  }

  .skill-category-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-tag {
    display: inline-block;
    padding: 0.35rem 0.65rem;
    background-color: var(--badge-bg);
    border: 1px solid var(--badge-border);
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .skill-tag:hover {
    color: var(--accent-primary);
    border-color: var(--border-strong);
    background-color: var(--bg-card-hover);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
